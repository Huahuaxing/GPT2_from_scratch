   "source": [
    "tiktoken是gpt2官方词表，由256 个基础字节 + 50000 个合并子词 + 1 个特殊 token `<|endoftext|>`组成。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "8e6b1429",
   "metadata": {},
   "outputs": [],
   "source": [
    "import tiktoken\n",
    "enc = tiktoken.get_encoding(\"gpt2\")\n",
    "# enc.n_vocab = 50257\n",
    "ids = enc.encode(\"Hello world\")\n",
    "text = enc.decode(ids)\n"
   ]
